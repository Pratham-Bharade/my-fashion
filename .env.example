# Application Configuration
APP_NAME="SilaiCraft Tailoring & Boutique"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/fashion_boutique_db
# For Local Development / Testing: sqlite:///./fashion_boutique.db
DATABASE_URL=sqlite:///./fashion_boutique.db

# Security & JWT
JWT_SECRET_KEY=super-secret-key-change-this-in-production-fashion-2026-secure!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# CORS (Frontend URLs)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Business Defaults
BUSINESS_NAME="SilaiCraft Couture & Tailoring"
BUSINESS_EMAIL="contact@silaicraft.com"
BUSINESS_PHONE="+91 98765 43210"
BUSINESS_WHATSAPP="+919876543210"

# Optional AI Features (Modular / Graceful fallback if empty)
AI_ENABLED=False
AI_API_KEY=
